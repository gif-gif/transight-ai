---
import images from '../config/selection-trigger.json';
import { selectionTrigger } from '../i18n/selection-trigger';
import type { Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = selectionTrigger[locale];
const image = images[locale];
---
<section class="selection-trigger" id="selection-trigger" aria-labelledby="selection-trigger-title">
  <header class="trigger-heading">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="selection-trigger-title">{t.title}</h2>
    <p>{t.description}</p>
  </header>
  <div class="trigger-layout">
    <figure>
      <a class="trigger-preview" href={image.full.src} data-lightbox={t.caption} aria-label={t.enlarge}>
        <img src={image.detail.src} width={image.detail.width} height={image.detail.height} alt={t.alt} loading="lazy" decoding="async" />
        <span class="trigger-enlarge">{t.enlarge}<span aria-hidden="true">⤢</span></span>
      </a>
      <figcaption>{t.caption}</figcaption>
      <p class="trigger-hint">{t.hint}</p>
    </figure>
    <ol class="trigger-steps" role="list">
      {t.steps.map((step, index) => <li><span class="trigger-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
    </ol>
  </div>
  <p class="trigger-privacy">{t.privacy}</p>
</section>
<style>
  .selection-trigger { padding-block: 64px; }
  .trigger-heading { max-width: 760px; margin-bottom: 32px; }
  .trigger-heading h2 { margin-block: 12px 16px; font-size: clamp(26px, 3vw, 38px); }
  .trigger-heading > p:last-child { color: var(--color-muted); }
  .trigger-layout { display: grid; grid-template-columns: 1.2fr 1fr; align-items: start; gap: 40px; }
  .trigger-layout > * { min-width: 0; }
  .trigger-preview { display: block; overflow: hidden; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); }
  .trigger-preview:hover { border-color: var(--color-brand); }
  .trigger-preview img { width: 100%; height: auto; }
  .trigger-enlarge { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; padding: 12px 18px; background: var(--color-soft); color: var(--color-brand); font-size: 14px; font-weight: 600; }
  figcaption, .trigger-hint { color: var(--color-muted); font-size: 13px; margin-top: 14px; }
  .trigger-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  .trigger-steps li { display: flex; align-items: start; gap: 14px; }
  .trigger-number { display: grid; place-items: center; flex: 0 0 30px; height: 30px; border-radius: 50%; background: var(--color-soft); color: var(--color-brand); font-weight: 600; }
  .trigger-steps h3 { font-size: 17px; margin-bottom: 6px; }
  .trigger-steps p { color: var(--color-muted); font-size: 14px; }
  .trigger-privacy { margin-top: 28px; padding: 16px 20px; border-left: 3px solid var(--color-brand); background: var(--color-soft); border-radius: 0 8px 8px 0; font-size: 14px; }
  @media (max-width: 760px) {
    .selection-trigger { padding-block: 40px; }
    .trigger-layout { grid-template-columns: 1fr; gap: 28px; }
  }
</style>

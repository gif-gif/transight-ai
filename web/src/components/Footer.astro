---
import { getDictionary, localePath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
---
<footer class="site-footer container">
  <div class="footer-top">
    <a class="brand" href={localePath(locale)}><img src="/favicon.svg" width="28" height="28" alt="" /><span>{t.brand}</span></a>
    <p>{t.footer.note}</p>
    <a class="text-link" href={localePath(locale, 'guide')}>{t.footer.guide} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {t.brand}</span><p>{t.footer.privacy}</p></div>
</footer>

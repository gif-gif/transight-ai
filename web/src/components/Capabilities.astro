---
import { capabilities } from '../i18n/capabilities';
import { localePath, type Locale } from '../i18n';
import images from '../config/screenshots.json';
import { screenshots } from '../i18n/screenshots';
interface Props { locale: Locale; detailed?: boolean }
const { locale, detailed = false } = Astro.props;
const t = capabilities[locale];
const previews = images[locale].filter(image => image.id === 'ai-page-confirm' || image.id === 'ai-page-result');
---
<section class:list={['capabilities', { detailed }]} id="capabilities" aria-labelledby="capabilities-title">
  <header class="section-heading"><p class="eyebrow">{t.eyebrow}</p><h2 id="capabilities-title">{t.title}</h2><p>{t.intro}</p></header>
  <div class="capability-grid">
    {t.items.map((item, index) => <article id={`capability-${item.id}`}>
      <span class="capability-number" aria-hidden="true">0{index + 1}</span>
      <h3>{item.title}</h3><p>{item.summary}</p>
      {detailed ? <ul>{item.details.map(detail => <li>{detail}</li>)}</ul> : <a class="text-link" href={`${localePath(locale, 'guide')}#capability-${item.id}`}>{t.guideLink}<span aria-hidden="true">↗</span></a>}
    </article>)}
  </div>
  {!detailed && <div class="capability-previews">
    {previews.map(image => <figure>
      <a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`${screenshots[locale].enlarge}: ${screenshots[locale].items[image.id as keyof typeof screenshots[typeof locale]['items']]}`}>
        <img src={image.src} width={image.width} height={image.height} alt={screenshots[locale].items[image.id as keyof typeof screenshots[typeof locale]['items']]} loading="lazy" decoding="async" />
      </a>
      <figcaption>{screenshots[locale].items[image.id as keyof typeof screenshots[typeof locale]['items']]}</figcaption>
    </figure>)}
    <p class="preview-note">{screenshots[locale].description}</p>
  </div>}
</section>
<style>
  .capabilities { padding-block: 64px; }
  .capability-grid, .capability-previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  article { padding: 28px; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); min-width: 0; overflow-wrap: anywhere; scroll-margin-top: 100px; }
  #capability-ai-page { grid-column: 1 / -1; border-color: var(--color-brand); }
  .capability-number { display: block; color: var(--color-brand); font-size: 13px; margin-bottom: 16px; }
  h3 { font-size: 22px; margin-bottom: 12px; }
  article p, li { color: var(--color-muted); }
  article .text-link { margin-top: 12px; }
  ul { padding-left: 20px; margin: 20px 0 0; }
  li + li { margin-top: 12px; }
  .detailed .capability-grid { grid-template-columns: 1fr; }
  .capability-previews { margin-top: 28px; }
  figure { min-width: 0; padding: 20px; background: var(--color-soft); border-radius: var(--radius); }
  figure a { display: block; }
  figure img { width: 100%; height: 360px; object-fit: contain; }
  figcaption { margin-top: 16px; font-size: 14px; font-weight: 600; text-align: center; }
  .preview-note { grid-column: 1 / -1; color: var(--color-muted); font-size: 13px; }
  @media (max-width: 760px) {
    .capabilities { padding-block: 40px; }
    .capability-grid, .capability-previews { grid-template-columns: 1fr; }
    article { padding: 22px; }
    figure img { height: auto; max-height: 420px; }
  }
</style>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, getDictionary, localePath, type Locale } from '../../i18n';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = getDictionary(locale);
---
<SiteLayout locale={locale} page="guide">
  <article class="guide container">
    <a class="text-link" href={localePath(locale)}><span aria-hidden="true">←</span>{t.guide.back}</a>
    <header class="guide-header"><p class="eyebrow">{t.guide.eyebrow}</p><h1>{t.guide.title}</h1><p>{t.guide.intro}</p></header>
    <aside class="notice"><h2>{t.guide.requirements}</h2><p>{t.guide.requirementText}</p></aside>
    <ol class="guide-steps" role="list">{t.guide.steps.map((step, index) => <li id={`step-${index + 1}`}>
      <span class="step-number">0{index + 1}</span>
      <div><h2>{step.title}</h2><p>{step.text}</p>{index === 0 && <pre><code>npm run build</code></pre>}<p class="step-detail">{step.detail}</p></div>
    </li>)}</ol>
    <aside class="notice" id="privacy"><h2>{t.guide.privacyTitle}</h2><p>{t.guide.privacyText}</p></aside>
  </article>
</SiteLayout>

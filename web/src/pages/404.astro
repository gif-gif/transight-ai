---
import { locales, localeInfo, localePath } from '../i18n';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><link rel="icon" href="/favicon.svg" /><title>404 — Yijian AI</title></head>
  <body><main class="language-entry container"><img src="/favicon.svg" width="56" height="56" alt="Yijian AI" /><p class="eyebrow">404</p><h1>Page not found</h1><p>页面未找到 · 頁面未找到</p><nav aria-label="Home pages">{locales.map((locale) => <a class="button button-primary" href={localePath(locale)} lang={localeInfo[locale].lang}>{localeInfo[locale].label}</a>)}</nav></main></body>
</html>
